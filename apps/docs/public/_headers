# VitePress ships hashed bundles under /assets/*
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts inlined by the default theme
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML and everything else — short browser cache only.
# No explicit CDN-Cache-Control: let CF Pages' default deploy-scoped cache
# handle the edge so new deploys are picked up immediately without a manual purge.
/*
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Service worker must revalidate on every request so new deploys are picked up immediately
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
