{
  "name": "@zwaggen/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup",
    "dev": "pnpm build && cross-env ZWAGGEN_DEV_URL=http://localhost:5173 electron dist/main.cjs",
    "start": "pnpm build && electron dist/main.cjs",
    "test": "vitest run",
    "e2e": "pnpm build && playwright test",
    "build:icons": "node scripts/build-icons.mjs",
    "pack": "pnpm build && pnpm --filter @zwaggen/web build && electron-builder --dir",
    "release": "pnpm build && pnpm --filter @zwaggen/web build && electron-builder"
  },
  "dependencies": {
    "@zwaggen/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.10",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.0",
    "tsup": "^8.2.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3",
    "yaml": "^2.5.0"
  }
}
