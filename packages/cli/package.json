{
  "name": "@zwaggen/cli",
  "version": "0.1.2",
  "description": "Zwaggen CI CLI — batch run + diff API specs (zwag)",
  "license": "MIT",
  "author": "Victor Liang",
  "homepage": "https://docs.zwaggen.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tubebigbig/Zwaggen.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "zwaggen",
    "openapi",
    "api",
    "ci",
    "cli",
    "diff",
    "smoke-test"
