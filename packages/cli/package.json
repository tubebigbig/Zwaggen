  },
  "devDependencies": {
    "@zwaggen/core": "workspace:*",
    "@types/node": "^20.14.10",
    "tsup": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
